{
  "name": "@rosarium/boost",
  "version": "1.1.0",
  "description": "The speed of a single-page web application without having to write any JavaScript",
  "module": "dist/boost.es2017-esm.js",
  "main": "dist/boost.es2017-umd.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/types/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotwired/turbo.git"
  },
  "keywords": [
    "hotwire",
    "boost",
    "browser",
    "pushstate"
  ],
  "author": "37signals LLC",
  "contributors": [
    "Jeffrey Hardy <jeff@basecamp.com>",
    "Javan Makhmali <javan@javan.us>",
    "Sam Stephenson <sstephenson@gmail.com>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hotwired/turbo/issues"
  },
  "homepage": "https://turbo.hotwired.dev",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@open-wc/testing": "^3.1.7",
    "@playwright/test": "~1.51.1",
    "@rollup/plugin-node-resolve": "13.1.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@web/dev-server-esbuild": "^0.3.3",
    "@web/test-runner": "^0.15.0",
    "@web/test-runner-playwright": "^0.9.0",
    "arg": "^5.0.1",
    "body-parser": "^1.20.1",
    "eslint": "^8.57.0",
    "express": "^4.18.2",
    "idiomorph": "~0.7.4",
    "multer": "^2.0.2",
    "rollup": "^2.35.1",
    "tslib": "^2.6.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "scripts": {
    "clean": "rm -fr dist",
    "clean:win": "rmdir /s /q dist",
    "build": "yarn install && tsc --emitDeclarationOnly --outDir dist/types && rollup -c",
    "build:win": "yarn install && tsc --emitDeclarationOnly --outDir dist/types && rollup -c",
    "watch": "rollup -wc",
    "start": "node src/tests/server.mjs",
    "test": "yarn test:unit && yarn test:browser",
    "test:browser": "playwright test",
    "test:unit": "NODE_OPTIONS=--inspect web-test-runner",
    "test:unit:win": "SET NODE_OPTIONS=--inspect & web-test-runner",
    "release": "yarn build && yarn publish",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.ts"
  },
  "engines": {
    "node": ">= 18"
  }
}
