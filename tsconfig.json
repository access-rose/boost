{
  "compilerOptions": {
    // Emit shape must match what the JS already is, so TypeScript is pure
    // erasure. NOT es2017 (what the dist filenames claim): the source is
    // already es2022 and there is currently no transpile step, so es2017 would
    // downlevel #private into WeakMaps and rewrite the published bundle.
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": [],
    "useDefineForClassFields": true,
    "removeComments": false,

    // Erasure-only guarantees. erasableSyntaxOnly makes enums, namespaces and
    // parameter properties a compile error rather than a review convention.
    "erasableSyntaxOnly": true,

    "rootDir": "src",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types"
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["dist", "src/tests/fixtures"]
}
